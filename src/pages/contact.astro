---
import BaseLayout from "../layouts/BaseLayout.astro";
const mailto = ""; // blank => '#'
const action = mailto ? "mailto:" + mailto : "#";
---
<BaseLayout>
  <h1 class="text-2xl font-semibold mb-4">Contact</h1>
  <form action={action} method="post" class="max-w-md space-y-3">
    <label class="block">
      <span class="block text-sm mb-1">Your email</span>
      <input name="email" type="email" required class="w-full">
    </label>
    <label class="block">
      <span class="block text-sm mb-1">Message</span>
      <textarea name="message" rows="4" required class="w-full"></textarea>
    </label>
    <button type="submit" class="px-3 py-1.5 rounded border" style="border-color:var(--color-border)">Send</button>
  </form>
</BaseLayout>
